# GraalVM native-image build for game-service.
# Build: docker build -f backend/game-service/Dockerfile.native -t game-native:spike .
# Note: native-image compilation is RAM-hungry (~4-6GB); on a small Docker VM it may OOM.
FROM ghcr.io/graalvm/graalvm-community:21 AS builder
ARG MAVEN_VERSION=3.9.9
RUN curl -fsSL "https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz" \
      | tar -xz -C /opt \
    && ln -s "/opt/apache-maven-${MAVEN_VERSION}/bin/mvn" /usr/local/bin/mvn
WORKDIR /build
COPY pom.xml /build/pom.xml
COPY backend/config-server/pom.xml /build/backend/config-server/pom.xml
COPY backend/eureka-server/pom.xml /build/backend/eureka-server/pom.xml
COPY backend/gateway/pom.xml /build/backend/gateway/pom.xml
COPY backend/auth-service/pom.xml /build/backend/auth-service/pom.xml
COPY backend/game-service/pom.xml /build/backend/game-service/pom.xml
COPY backend/game-service/src /build/backend/game-service/src
RUN mvn -Pnative -pl backend/game-service -DskipTests native:compile

FROM debian:bookworm-slim
WORKDIR /app
COPY --from=builder /build/backend/game-service/target/game-service /app/game-service
EXPOSE 8082
ENTRYPOINT ["/app/game-service"]
